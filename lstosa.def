## ─────────────────────────────────────────────────────────────────────────────
## singularity/Singularity definition file for the LST-1 on-site analysis (lstosa).
##
## Goal: bake lstchain + lstosa + their full dependency tree into a single SIF
## image so SLURM jobs no longer pay the per-job cost of activating a conda env
## living on the shared (network) filesystem. Inside the SIF the environment is a
## read-optimised squashfs, so `import lstchain/ctapipe` is fast and local.
##
## Pinned to match the known-good production environment (PROD_ID v0.12):
##     Python 3.11 · lstchain 0.12.2 · ctapipe 0.25.1 · ctapipe_io_lst 0.29.0
##
## ── Build ────────────────────────────────────────────────────────────────────
##   cd /fefs/aswg/workspace/guillaume.grolleron/project/lstosa
##   singularity build lstosa_v0.12.sif lstosa.def
##   # (use --fakeroot if you are not root:  singularity build --fakeroot ...)
##
## ── Use ──────────────────────────────────────────────────────────────────────
##   # one-off command
##   singularity exec lstosa_v0.12.sif sequencer --version
##   singularity exec lstosa_v0.12.sif lstchain_data_r0_to_dl1 --help
##
##   # bind the data trees the pipeline reads/writes (singularity auto-binds $HOME
##   # and the CWD, but /fefs subtrees usually need to be explicit):
##   singularity exec \
##       --bind /fefs/aswg,/fefs/onsite,/fefs/home \
##       lstosa_v0.12.sif datasequence ...
##
##   # ACTIVE DEVELOPMENT of lstosa: bind your host checkout over /opt/lstosa so
##   # your edits are live without rebuilding (the image installed it editable):
##   singularity exec \
##       --bind /fefs/aswg/workspace/guillaume.grolleron/project/lstosa:/opt/lstosa \
##       --bind /fefs/aswg,/fefs/onsite,/fefs/home \
##       lstosa_v0.12.sif sequencer ...
## ─────────────────────────────────────────────────────────────────────────────

Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%files
    # Copy the lstosa source into the image. Path is relative to the build CWD, so
    # run `singularity build` from the repo root (the dir holding pyproject.toml).
    # IMPORTANT: the synced tree must include .git — setuptools_scm derives the
    # version from it at install time (the version is removed below, post-install).
    # Installed editable so a runtime bind-mount over /opt/lstosa picks up edits.
    . /opt/lstosa

%post
    set -eux
    export MAMBA_ROOT_PREFIX=/opt/conda

    # ---- Reproduce the known-good conda-forge stack ------------------------
    # The production host env installs EVERYTHING from conda-forge, including
    # lstchain and every compiled dependency (numpy, numba, llvmlite, protozfits,
    # eventio, ctapipe, ...). Installing lstchain from conda-forge here pulls the
    # same conda-forge builds, instead of pip manylinux wheels — which is what
    # caused the SIGSEGV (exit -11) core dumps in r0_to_dl1 on the compute nodes.
    # lstchain=0.12.2 constrains ctapipe 0.25.x / ctapipe_io_lst 0.29.x / gammapy 1.3,
    # matching the production environment. The extra packages are lstosa's
    # pure-python deps not necessarily dragged in by lstchain.
    micromamba install -y -n base -c conda-forge \
        python=3.11 pip git \
        lstchain=0.12.2 \
        pydot pydotplus prov pymongo toml psutil pyyaml click setuptools
    eval "$(micromamba shell hook --shell posix)"
    micromamba activate base

    # ---- lstosa itself (editable, --no-deps: the whole dependency tree is
    #      already provided by conda-forge above, so pip must NOT pull any wheel
    #      that could reintroduce a mismatched compiled build) ----------------
    pip install --no-deps -e /opt/lstosa

    # ---- slim the image ----------------------------------------------------
    rm -rf /opt/lstosa/.git
    micromamba clean -a -y
    pip cache purge || true
    find /opt/conda -name '__pycache__' -type d -prune -exec rm -rf {} + || true

    # quick import smoke-test (fails the build early if the env is broken)
    python - <<'PY'
import lstchain, ctapipe, ctapipe_io_lst, osa
print("lstchain", lstchain.__version__)
print("ctapipe", ctapipe.__version__)
print("ctapipe_io_lst", ctapipe_io_lst.__version__)
print("osa OK")
PY

%environment
    # Flat env: putting /opt/conda/bin on PATH "activates" it (python + all the
    # pip-installed console scripts: sequencer, datasequence, lstchain_*, ...).
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:$PATH
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # Keep matplotlib/astropy/ctapipe caches off the network FS unless the caller
    # overrides them (the lstosa config also sets these per-run).
    export MPLCONFIGDIR=${MPLCONFIGDIR:-/tmp/mpl-$USER}
    # /opt/conda is a read-only squashfs at runtime, so numba's @njit(cache=True)
    # functions (e.g. ctapipe.image.statistics) can't write their cache next to
    # the source file. Redirect numba's cache to a writable location.
    export NUMBA_CACHE_DIR=${NUMBA_CACHE_DIR:-/tmp/numba-$USER}

%runscript
    # `singularity run lstosa_v0.12.sif <cmd> <args>` executes inside the env.
    exec "$@"

%test
    set -e
    export PATH=/opt/conda/bin:$PATH
    # %test runs against the finalized read-only SIF, so numba can't cache
    # next to the (read-only) source; redirect it (see %environment).
    export NUMBA_CACHE_DIR=/tmp/numba-test
    python -c "import lstchain, ctapipe, ctapipe_io_lst, osa; print('container OK', lstchain.__version__)"
    sequencer --help >/dev/null && echo "sequencer entrypoint OK"

%labels
    Maintainer grolleron@lapp.in2p3.fr
    Component lstosa
    Lstchain 0.12.2
    Ctapipe 0.25.1
    Python 3.11
    Description LST-1 on-site analysis (lstosa) pipeline image for DL1 reprocessing (PROD_ID v0.12)

%help
    singularity image for the LST-1 on-site analysis pipeline (lstosa) pinned to the
    v0.12 production stack (lstchain 0.12.2 / ctapipe 0.25.1). Built to replace the
    network-filesystem conda environment so SLURM jobs start fast.

    Build:
        cd <lstosa repo root>
        singularity build lstosa_v0.12.sif lstosa.def

    Run a pipeline command (bind the data trees it touches):
        singularity exec --bind /fefs/aswg,/fefs/onsite,/fefs/home \
            lstosa_v0.12.sif datasequence --help

    Live-edit lstosa without rebuilding (bind your checkout over /opt/lstosa):
        singularity exec --bind <host>/lstosa:/opt/lstosa,/fefs/aswg \
            lstosa_v0.12.sif sequencer ...

    NOTE: This image does NOT include lstcam_calib (Cat-A calibration), which the
    reprocessing skips via --no-calib/--no-gainsel. If you ever need Cat-A, build a
    second image from environment-lstcam.yml (pip install lstcam_calib).
